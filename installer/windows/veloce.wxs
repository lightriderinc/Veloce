<?xml version="1.0" encoding="UTF-8"?>
<!--
  Veloce Desktop MSI (WiX Toolset v5).

  Build inputs (passed by installer/windows/build-release.ps1):
    PayloadDir      PyInstaller one-directory payload containing Veloce.exe
    ProductVersion  release version, for example 1.2.0
    BrandingDir     assets/branding (veloce.ico, wix-banner.bmp, wix-dialog.bmp)
  Extensions: WixToolset.UI.wixext and WixToolset.Util.wixext (added by the script).
    LicenseRtf      RTF rendering of LICENSE written by the desktop packager

  The lib\ payload holds the hash-recorded FIPS module and PQC provider. The
  installer copies those files byte for byte; it never patches or signs them.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Veloce Desktop"
           Manufacturer="Lightrider Inc"
           Version="$(ProductVersion)"
           UpgradeCode="B1F95227-6988-4FEA-9705-485619A6E0CB"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer Veloce Desktop version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Brand identity: executable, Start Menu shortcut, Apps and features entry -->
    <Icon Id="VeloceIcon" SourceFile="$(BrandingDir)\veloce.ico" />
    <Property Id="ARPPRODUCTICON" Value="VeloceIcon" />
    <Property Id="ARPCOMMENTS" Value="Veloce PQC SDK: qSearch cryptographic discovery and FIPS 140-3 validation dashboard" />
    <!-- ARPNOMODIFY is defined by WixUI_InstallDir; declaring it here duplicates it (WIX0091). -->

    <!-- Installer dialogs carry the Lightrider artwork (spec 7.3) -->
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(BrandingDir)\wix-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(BrandingDir)\wix-dialog.bmp" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!-- Click to run: the exit dialog offers to launch the app -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Veloce Desktop" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#VeloceDesktopExe]" />
    <CustomAction Id="LaunchVeloceDesktop"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchVeloceDesktop"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Veloce">
        <Component Id="VeloceDesktopExecutable" Guid="*">
          <File Id="VeloceDesktopExe" Source="$(PayloadDir)\Veloce.exe" KeyPath="yes">
            <Shortcut Id="VeloceStartMenuShortcut"
                      Directory="ProgramMenuFolder"
                      Name="Veloce Desktop"
                      Description="qSearch cryptographic discovery and FIPS validation dashboard"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="VeloceIcon" />
          </File>
        </Component>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="VelocePayload" Directory="INSTALLFOLDER">
      <Files Include="$(PayloadDir)\**">
        <Exclude Files="$(PayloadDir)\Veloce.exe" />
      </Files>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Veloce Desktop" Level="1">
      <ComponentRef Id="VeloceDesktopExecutable" />
      <ComponentGroupRef Id="VelocePayload" />
    </Feature>
  </Package>
</Wix>
